# Never send local secrets or databases into Docker build contexts.
.git
.github
.env
.env.*
!.env.example
secrets
**/secrets
*.sqlite3
*.sqlite3-*
*.db
*.har
*.log
backups
*.zip

# Build only the required sources.
**/node_modules
**/__pycache__
**/*.pyc
.venv
frontend/dist
frontend/.vite
*.test.mjs
.pytest_cache
.mypy_cache
.DS_Store
