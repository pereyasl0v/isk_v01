# VPS: замените your-domain.example на домен за HTTPS reverse proxy.
ISK_BIND_ADDR=127.0.0.1
ISK_PORT=8000
ISK_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.example
ISK_ALLOWED_ORIGINS=https://your-domain.example
ISK_SECURE_COOKIE=true
# Публичный адрес ИСК для push-уведомлений Ozon, если подключите их.
ISK_PUBLIC_URL=https://your-domain.example
WB_DESTINATION=1259570991
